<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/notification_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/notif_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="Album art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder_album" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notification_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notification_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notif_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Previous"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_prev" />

    <ImageButton
        android:id="@+id/notif_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Play or pause"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_play" />

    <ImageButton
        android:id="@+id/notif_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Next"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_next" />
</LinearLayout>
